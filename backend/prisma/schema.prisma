generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoPedido {
  BORRADOR
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

model Cliente {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(150)
  email          String?  @unique @db.VarChar(254)
  passwordHash   String?  @map("password_hash") @db.VarChar(255)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  pedidos Pedido[]

  @@map("clientes")
}

model Articulo {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique @db.VarChar(50)
  nombre         String   @db.VarChar(150)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  stock          Int      @default(0)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  lineasPedido LineaPedido[]

  @@map("articulos")
}

model Pedido {
  id             Int          @id @default(autoincrement())
  numeroPedido   String       @unique @map("numero_pedido") @db.VarChar(30)
  clienteId      Int          @map("cliente_id")
  fechaPedido    DateTime     @default(now()) @map("fecha_pedido") @db.Date
  fechaEntrega   DateTime?    @map("fecha_entrega") @db.Date
  estado         EstadoPedido @default(BORRADOR)
  creadoEn       DateTime     @default(now()) @map("creado_en")
  actualizadoEn  DateTime     @updatedAt @map("actualizado_en")

  cliente Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  lineas  LineaPedido[]

  @@index([clienteId])
  @@map("pedidos")
}

model LineaPedido {
  id             Int     @id @default(autoincrement())
  pedidoId       Int     @map("pedido_id")
  articuloId     Int     @map("articulo_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  descuento      Decimal @default(0) @db.Decimal(5, 2)
  importe        Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  articulo Articulo @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, articuloId])
  @@index([pedidoId])
  @@index([articuloId])
  @@map("pedido_lineas")
}
