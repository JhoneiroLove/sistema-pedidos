# PostgreSQL. DATABASE_URL usa el hostname del servicio Docker: postgres.
POSTGRES_DB=sistema_pedidos
POSTGRES_USER=pedidos_app
POSTGRES_PASSWORD=cambiar_por_clave_larga_2026
DATABASE_URL=postgresql://pedidos_app:cambiar_por_clave_larga_2026@postgres:5432/sistema_pedidos?schema=public
DATABASE_SCHEMA=public

# Backend
JWT_SECRET=reemplazar_con_48_bytes_aleatorios_como_minimo
CORS_ORIGINS=http://localhost:3100
ENABLE_SWAGGER=true

# Next.js. Debe ser base64 de exactamente 32 bytes.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=reemplazar_con_openssl_rand_base64_32

# Puertos host. En Dokploy pueden mantenerse porque ligan solo a loopback.
FRONTEND_HOST_PORT=3100
BACKEND_HOST_PORT=3101
PRISMA_STUDIO_HOST_PORT=5555
